<settings-container>
  <horizontal pref-height='7' horizontal-fit='PreferredSize' vertical-fit='PreferredSize'>
    <text text='~status' font-size='3.2' align='Center' pref-height='7' />
  </horizontal>
  <dropdown-list-setting text='~t_lang' hover-hint='~t_lang_hint' value='lang' options='langs' apply-on-change='true' bind-value='true' />
  <toggle-setting text='~t_enabled' value='enabled' apply-on-change='true' bind-value='true' />
  <toggle-setting text='~t_cha' value='cha' apply-on-change='true' bind-value='true' />
  <toggle-setting text='~t_chb' value='chb' apply-on-change='true' bind-value='true' />
  <dropdown-list-setting id='wave-list' text='~t_wave' hover-hint='~t_wave_hint' value='wave' options='waves' apply-on-change='true' bind-value='true' />
  <button text='~t_reloadwaves' hover-hint='~t_reloadwaves_hint' on-click='reloadwaves' />
  <slider-setting text='~t_coef' hover-hint='~t_coef_hint' value='coef' min='0.1' max='2' increment='0.05' apply-on-change='true' bind-value='true' />
  <slider-setting text='~t_heal' hover-hint='~t_heal_hint' value='heal' min='0.25' max='3' increment='0.25' apply-on-change='true' bind-value='true' />
  <slider-setting text='~t_cap' hover-hint='~t_cap_hint' value='cap' min='0' max='100' increment='5' integer-only='true' apply-on-change='true' bind-value='true' />
  <slider-setting text='~t_rise' value='rise' min='1' max='60' increment='1' apply-on-change='true' bind-value='true' />
  <slider-setting text='~t_fail' value='fail' min='0' max='10' increment='0.5' apply-on-change='true' bind-value='true' />
  <toggle-setting text='~t_zeropause' value='zeropause' apply-on-change='true' bind-value='true' />
  <toggle-setting text='~t_nofail' value='nofail' apply-on-change='true' bind-value='true' />
  <toggle-setting text='~t_overlay' value='overlay' apply-on-change='true' bind-value='true' />
  <toggle-setting text='~t_edit' hover-hint='~t_edit_hint' value='edit' apply-on-change='true' bind-value='true' />
  <slider-setting text='~t_ox' value='ox' min='-8' max='8' increment='0.1' apply-on-change='true' bind-value='true' />
  <slider-setting text='~t_oy' value='oy' min='-1' max='5' increment='0.1' apply-on-change='true' bind-value='true' />
  <slider-setting text='~t_oz' value='oz' min='1' max='15' increment='0.1' apply-on-change='true' bind-value='true' />
  <slider-setting text='~t_osize' value='osize' min='0.3' max='3' increment='0.1' apply-on-change='true' bind-value='true' />
  <button text='~t_resethud' on-click='resethud' />
  <horizontal pref-height='10' vertical-fit='PreferredSize'>
    <button text='~t_estop' on-click='estop' />
    <button text='~t_resume' on-click='resume' />
  </horizontal>
</settings-container>
